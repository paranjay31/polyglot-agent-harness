{
  "name": "polyglot-agent-harness",
  "version": "0.1.1",
  "description": "Extensible, repository-aware coding-agent harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paranjay31/polyglot-agent-harness.git"
  },
  "bugs": {
    "url": "https://github.com/paranjay31/polyglot-agent-harness/issues"
  },
  "homepage": "https://github.com/paranjay31/polyglot-agent-harness#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "agent": "dist/apps/cli/src/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    ".agent/config.example.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx apps/cli/src/main.ts",
    "server": "tsx apps/server/src/main.ts",
    "acp": "tsx apps/acp/src/main.ts",
    "remote-worker": "tsx apps/remote-worker/src/main.ts",
    "prepack": "corepack pnpm build"
  },
  "dependencies": {
    "@lezer/java": "1.1.3",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
